# Written by `uv run python -m qlens.setup_db` (private cluster started by `python -m qlens.pg_local start`).
DATABASE_URL=postgresql://qlens_app:CHANGE_ME@localhost:5544/qlens
TEST_DATABASE_URL=postgresql://qlens_app:CHANGE_ME@localhost:5544/qlens_test
SECRET_KEY=64-hex-characters
# Optional: enables the assistant (Design command bar and Data > Ask AI) through Google Gemini function calling.
# Without a key both say so and stay off. Get a key at https://aistudio.google.com/apikey.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Production only (see DEPLOY.md); local development leaves these unset.
# APP_ENV=production
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# ROLE_PREFIX=qlens_ws_
